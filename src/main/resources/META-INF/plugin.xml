<idea-plugin>
  <depends>com.intellij.modules.lang</depends>
  <description><![CDATA[
  Formatting, highlighting, code completion and source debugging for <a href="https://github.com/ljunker/Kasm">KASM</a>
  ]]>
  </description>
  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.parameterInfo
      implementationClass="de.ljunker.kasm.intellij.KasmParameterInfoHandler"
      language="KASM"/>
    <completion.contributor
      implementationClass="de.ljunker.kasm.intellij.KasmCompletionContributor"
      language="KASM"/>
    <fileType
      extensions="kasm"
      fieldName="INSTANCE"
      implementationClass="de.ljunker.kasm.intellij.KasmFileType"
      language="KASM"
      name="KASM"/>
    <lang.formatter
      implementationClass="de.ljunker.kasm.intellij.KasmFormattingModelBuilder"
      language="KASM"/>
    <lang.parserDefinition
      implementationClass="de.ljunker.kasm.intellij.KasmParserDefinition"
      language="KASM"/>
    <lang.syntaxHighlighterFactory
      implementationClass="de.ljunker.kasm.intellij.KasmSyntaxHighlighterFactory"
      language="KASM"/>
    <postFormatProcessor
      implementation="de.ljunker.kasm.intellij.KasmPostFormatProcessor"/>
    <configurationType
      implementation="de.ljunker.kasm.intellij.KasmRunConfigurationType"/>
    <programRunner
      implementation="de.ljunker.kasm.intellij.KasmDebugRunner"/>
    <runConfigurationProducer
      implementation="de.ljunker.kasm.intellij.KasmRunConfigurationProducer"/>
    <xdebugger.breakpointType
      implementation="de.ljunker.kasm.intellij.KasmLineBreakpointType"/>
  </extensions>

  <name>KASM Language</name>

  <vendor>Lars Junker</vendor>
  <id>de.ljunker.kasm</id>
</idea-plugin>
